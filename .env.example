# Notion Integration API Key
# Get from: https://www.notion.so/my-integrations → Create integration → Internal Integration Secret
VITE_NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database ID for AI Resources
# Get from: Open the database in Notion → copy ID from URL
# URL format: notion.so/{workspace}/{DATABASE_ID}?v=...
VITE_NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
